---
import Layout from "@layouts/Layout.astro";
import WidgetTitle from "@components/WidgetTitle.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import Sesepuh from "@components/Sesepuh.astro";
import Content from "@components/Content.astro";
import Sidebar from "@components/Sidebar.astro";
import animeConfig from "@configs/animeConfig";
import generateUrlPath from "@utils/generateUrlPath";
import PlayIcon from "@components/icons/PlayIcon.astro";
import StarIcon from "@components/icons/StarIcon.astro";
import AnimeDetails from "@components/AnimeDetails.astro";
import Error from "@components/Error.astro";
import animeInfoService from "@services/animeInfoService"; 
import genreService from "@services/genreService";
import animeByGenreService from "@services/animeByGenreService";
import AnimeList2 from "@components/AnimeList2.astro";

const config = (animeConfig as any).default || animeConfig;
const {
  molidonghub: { siteName },
} = config;

const { animeId } = Astro.params;

const animeInfo = await animeInfoService({ animeId: animeId! });
const { data, ok, statusCode, message, statusMessage } = animeInfo;

const allGenresData = await genreService();
// Filter valid genres only
const sidebarGenreList = allGenresData.ok 
  ? allGenresData.data.genreList.filter(g => 
      !/^(\d{4}|spring|summer|fall|winter)/i.test(g.title) &&
      g.title && g.genreId && 
      g.title.trim().length > 0 && 
      g.genreId.trim().length > 0
    )
  : [];

const title = ok ? `Anime ${data.title} - ${siteName}` : `Error - ${siteName}`;
const description = ok && data.synopsis?.paragraphs ? data.synopsis.paragraphs[0] : "";

const lastEpisode = (ok && data.episodeList && data.episodeList.length > 0)
  ? data.episodeList[data.episodeList.length - 1]
  : null;

// Get recommendations based on first genre
let recommendations: animeCard2[] = [];
if (ok && data.genreList && data.genreList.length > 0) {
  const firstGenre = data.genreList[0];
  const genreAnimeResult = await animeByGenreService({ 
    genreId: firstGenre.genreId, 
    page: "1" 
  });
  
  if (genreAnimeResult.ok) {
    recommendations = genreAnimeResult.data.animeList
      .filter((anime: any) => anime.animeId !== animeId)
      .slice(0, 12);
  }
}
---

{
  !ok ? (
    <Error statusCode={statusCode} message={message || statusMessage} />
  ) : (
    <Layout
      seo={{
        title,
        description: description,
      }}
    >
      <Breadcrumb
        currentPage={{
          title: data.title,
          href: Astro.url.href,
          action: "replace",
        }}
      />
      <Sesepuh>
        <Content>
          <div class="relative">
            <img
              src={data.poster || "/images/logo.png"}
              class="w-full aspect-[16/6] object-cover rounded-t-md"
              alt={data.title}
              onerror="this.src='/images/logo.png';this.onerror=null;"
            />
            <div class="absolute top-0 right-0 bottom-0 left-0 rounded-t-md bg-gradient-to-t from-zinc-100 dark:from-zinc-900 to-transparent" />
          </div>

          <div class="flex flex-col sm:flex-row justify-center items-center sm:justify-start gap-4 sm:items-end xs:-mt-[100px] sm:-mt-[150px] relative p-4">
            <img
              src={data.poster || "/images/logo.png"}
              alt={data.title}
              class="w-[150px] sm:w-[170px] md:w-[200px] rounded-md aspect-[3/4]"
              onerror="this.src='/images/logo.png';this.onerror=null;"
            />
            <div class="flex flex-col gap-3 items-center text-center sm:items-start sm:text-left">
              <h1 class="text-xl md:text-2xl font-extrabold line-clamp-2">
                {data.title || data.synonyms}
              </h1>
              <p class="flex">
                <span class="flex gap-1 items-center">
                  <StarIcon class="w-4 h-4" />
                  {data.score.value} | {data.status}
                </span>
              </p>
              <div class="flex gap-3">
                {lastEpisode && (
                  <a
                    href={generateUrlPath("/episode", lastEpisode.episodeId)}
                    class="flex gap-2 items-center text-white bg-amber-700 hover:bg-amber-800 focus:outline-none focus:ring-4 focus:ring-amber-300 font-medium rounded-full text-sm px-5 py-2.5 text-center dark:bg-amber-600 dark:hover:bg-amber-700 dark:focus:ring-amber-800 transition-all duration-200 hover:scale-105"
                  >
                    <PlayIcon />
                    Tonton
                  </a>
                )}
                <button
                  id="bookmark-btn"
                  data-anime-id={animeId}
                  data-anime-title={data.title}
                  data-anime-poster={data.poster}
                  class="flex gap-2 items-center bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-white hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black font-medium rounded-full text-sm px-5 py-2.5 transition-all duration-200 hover:scale-105"
                  title="Tambah ke Bookmark"
                >
                  <svg id="bookmark-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                  </svg>
                  <span id="bookmark-text">Bookmark</span>
                </button>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            {data.synopsis.paragraphs.map((paragraph) => (
              <p class="text-zinc-600 dark:text-zinc-400">{paragraph}</p>
            ))}
          </div>

          <WidgetTitle title="Detail Anime" />
          {/* FIX: Gunakan Component PascalCase */}
          <AnimeDetails anime={data} />

          {data.batchList.length > 0 && (
            <>
              <WidgetTitle title="Download Batch" />
              {data.batchList.map((batch) => (
                <a href={generateUrlPath("/batch", batch.batchId)} class="line-clamp-2 flex gap-1 text-white bg-amber-700 hover:bg-amber-800 focus:outline-none focus:ring-4 focus:ring-amber-300 font-medium rounded-md text-sm px-5 py-2.5 text-center dark:bg-amber-600 dark:hover:bg-amber-700 dark:focus:ring-amber-800">
                  {batch.title}
                </a>
              ))}
            </>
          )}

          {data.trailer && (
            <iframe src={data.trailer} allowfullscreen class="aspect-video rounded-lg" />
          )}

          <WidgetTitle title="Daftar Episode" />
          <div class="flex flex-col gap-4 max-h-[500px] overflow-y-auto custom-scrollbar">
            {data.episodeList && data.episodeList.length > 0 ? (
              data.episodeList.map((episode) => {
                try {
                  // Extract episode number from episodeId
                  const episodeParts = episode.episodeId.split('-');
                  const episodeNumber = episodeParts[episodeParts.length - 1];
                  const epsTitle = episode.title || `Episode ${episodeNumber}`;
                  
                  return (
                    <a 
                      href={generateUrlPath("/episode", episode.episodeId)} 
                      class="flex gap-4 items-center hover:bg-zinc-300 dark:hover:bg-zinc-700 p-2 rounded-md transition-colors duration-200"
                    >
                      <div class="text-white py-2 px-4 bg-sky-700 dark:bg-sky-600 rounded-sm min-w-max">
                        {epsTitle}
                      </div>
                      <div class="line-clamp-1">
                        {data.title} {epsTitle}
                      </div>
                    </a>
                  );
                } catch (error) {
                  console.error('Error rendering episode:', episode, error);
                  return null;
                }
              })
            ) : (
              <div class="text-center py-4 text-zinc-500">
                Tidak ada episode tersedia
              </div>
            )}
          </div>

          {recommendations.length > 0 && (
            <>
              <WidgetTitle title="Rekomendasi Untuk Kamu" />
              <AnimeList2 
                anime={{ 
                  list: recommendations, 
                  baseUrlPath: "/anime" 
                }} 
              />
            </>
          )}
        </Content>

        <Sidebar>
           <WidgetTitle title="Daftar Genre" href="/genres" />
            <div class="flex flex-wrap gap-2 mb-6 max-h-64 overflow-y-auto pr-1 custom-scrollbar">
            {sidebarGenreList.map((genre) => (
                <a href={generateUrlPath("/genres", genre.genreId)} class="text-xs font-medium px-2.5 py-1.5 rounded bg-zinc-200 text-zinc-800 hover:bg-amber-600 hover:text-white dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-amber-600 transition-colors">
                {genre.title}
                </a>
            ))}
            </div>
          <WidgetTitle title="Sidebar" />
        </Sidebar>
      </Sesepuh>
    </Layout>
  )
}

<script>
  import { BookmarkManager } from '@utils/bookmarkManager';

  document.addEventListener('DOMContentLoaded', () => {
    const bookmarkBtn = document.getElementById('bookmark-btn');
    const bookmarkIcon = document.getElementById('bookmark-icon');
    const bookmarkText = document.getElementById('bookmark-text');

    if (!bookmarkBtn) return;

    const animeId = bookmarkBtn.getAttribute('data-anime-id') || '';
    const animeTitle = bookmarkBtn.getAttribute('data-anime-title') || '';
    const animePoster = bookmarkBtn.getAttribute('data-anime-poster') || '';

    // Update button state
    function updateButtonState() {
      const isBookmarked = BookmarkManager.isBookmarked(animeId);
      
      if (bookmarkIcon && bookmarkText) {
        if (isBookmarked) {
          bookmarkIcon.setAttribute('fill', 'currentColor');
          bookmarkText.textContent = 'Tersimpan';
          bookmarkBtn?.classList.add('bg-amber-600', 'text-white', 'dark:bg-amber-600');
          bookmarkBtn?.classList.remove('bg-zinc-200', 'dark:bg-zinc-800');
        } else {
          bookmarkIcon.setAttribute('fill', 'none');
          bookmarkText.textContent = 'Bookmark';
          bookmarkBtn?.classList.remove('bg-amber-600', 'text-white', 'dark:bg-amber-600');
          bookmarkBtn?.classList.add('bg-zinc-200', 'dark:bg-zinc-800');
        }
      }
    }

    // Initial state
    updateButtonState();

    // Toggle bookmark
    bookmarkBtn.addEventListener('click', () => {
      const isBookmarked = BookmarkManager.toggle({
        animeId,
        title: animeTitle,
        poster: animePoster
      });

      updateButtonState();

      // Show toast notification
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-8 right-8 bg-black dark:bg-white text-white dark:text-black px-6 py-3 rounded-lg shadow-2xl z-50 animate-fade-in';
      toast.textContent = isBookmarked ? '✓ Ditambahkan ke bookmark' : '✓ Dihapus dari bookmark';
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 2000);
    });

    // Listen for updates
    window.addEventListener('bookmarksUpdated', updateButtonState);
  });
</script>
