---
import animeConfig from "@configs/animeConfig";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import generateUrlPath from "@utils/generateUrlPath";

const config = (animeConfig as any).default || animeConfig;
const {
  molidonghub: { siteName },
} = config;
---

<Layout
  seo={{
    title: `Bookmark Favorit - ${siteName}`,
    description: "Daftar donghua dan anime favorit yang telah di-bookmark",
  }}
>
  <Breadcrumb />
  
  <div class="py-8">
    <div class="text-center space-y-3 mb-12">
      <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-zinc-900 via-zinc-700 to-zinc-900 dark:from-zinc-100 dark:via-zinc-300 dark:to-zinc-100 bg-clip-text text-transparent">
        Bookmark Favorit
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400">
        Daftar donghua dan anime yang kamu simpan
      </p>
    </div>

    <div id="bookmarks-container" class="min-h-[400px]">
      <!-- Loading state -->
      <div id="loading-state" class="text-center py-20">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-zinc-200 dark:border-zinc-700 border-t-black dark:border-t-white"></div>
        <p class="mt-4 text-zinc-600 dark:text-zinc-400">Memuat bookmark...</p>
      </div>

      <!-- Empty state -->
      <div id="empty-state" class="hidden text-center py-20">
        <div class="text-6xl mb-4">📌</div>
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-2">
          Belum Ada Bookmark
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 mb-6">
          Klik ikon bookmark di halaman detail anime untuk menyimpannya di sini
        </p>
        <a 
          href="/" 
          class="inline-block px-6 py-3 bg-black dark:bg-white text-white dark:text-black font-medium rounded-xl hover:scale-105 transition-transform duration-200"
        >
          Jelajahi Donghua
        </a>
      </div>

      <!-- Bookmarks grid -->
      <div id="bookmarks-grid" class="hidden grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
        <!-- Will be populated by JavaScript -->
      </div>
    </div>
  </div>
</Layout>

<script>
  import { BookmarkManager } from '@utils/bookmarkManager';

  function renderBookmarks() {
    const bookmarks = BookmarkManager.getAll();
    const loadingState = document.getElementById('loading-state');
    const emptyState = document.getElementById('empty-state');
    const bookmarksGrid = document.getElementById('bookmarks-grid');

    if (loadingState) loadingState.classList.add('hidden');

    if (bookmarks.length === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (bookmarksGrid) bookmarksGrid.classList.add('hidden');
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');
    if (bookmarksGrid) {
      bookmarksGrid.classList.remove('hidden');
      
      bookmarksGrid.innerHTML = bookmarks.map(bookmark => `
        <div class="group relative" data-anime-id="${bookmark.animeId}">
          <a href="/anime/${bookmark.animeId}" class="block">
            <div class="relative aspect-[2/3] rounded-xl overflow-hidden mb-3 bg-zinc-100 dark:bg-zinc-800 transition-all duration-300 group-hover:scale-105 group-hover:shadow-2xl">
              <img
                src="${bookmark.poster}"
                alt="${bookmark.title}"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
                loading="lazy"
                onerror="this.src='/images/placeholder-anime.png'"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <h3 class="font-semibold text-sm text-zinc-900 dark:text-white line-clamp-2 group-hover:text-black dark:group-hover:text-zinc-300 transition-colors duration-200 min-h-[2.5rem]">
              ${bookmark.title}
            </h3>
          </a>
          <button
            onclick="removeBookmark('${bookmark.animeId}')"
            class="absolute top-2 right-2 p-2 bg-red-500 text-white rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 hover:bg-red-600 z-10"
            title="Hapus Bookmark"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      `).join('');
    }
  }

  // Make removeBookmark available globally
  (window as any).removeBookmark = function(animeId: string) {
    BookmarkManager.remove(animeId);
    renderBookmarks();
  };

  // Initial render
  document.addEventListener('DOMContentLoaded', renderBookmarks);

  // Listen for updates
  window.addEventListener('bookmarksUpdated', renderBookmarks);
</script>
