---
import animeConfig from "@configs/animeConfig";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";

const config = (animeConfig as any).default || animeConfig;
const {
  molidonghub: { siteName },
} = config;
---

<Layout
  seo={{
    title: `Disclaimers - ${siteName}`,
    description: "Disclaimer dan ketentuan penggunaan website",
  }}
>
  <Breadcrumb />
  
  <div class="py-8 max-w-4xl mx-auto">
    <div class="text-center space-y-3 mb-12">
      <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-zinc-900 via-zinc-700 to-zinc-900 dark:from-zinc-100 dark:via-zinc-300 dark:to-zinc-100 bg-clip-text text-transparent">
        Disclaimers
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400">
        Ketentuan dan disclaimer penggunaan website
      </p>
    </div>

    <div class="space-y-8">
      <!-- Content Policy -->
      <section class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-8 space-y-4 transition-all duration-300 hover:shadow-xl">
        <div class="flex items-start gap-4">
          <span class="text-3xl">📝</span>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">
              Content Policy
            </h2>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              <strong class="text-zinc-900 dark:text-white">{siteName}</strong> tidak menyimpan file video apapun di server kami. 
              Semua konten yang ditampilkan di website ini bersumber dari pihak ketiga yang terhubung melalui link eksternal. 
              Kami hanya menyediakan akses untuk menonton streaming online dan download melalui server pihak ketiga.
            </p>
          </div>
        </div>
      </section>

      <!-- Copyright Notice -->
      <section class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-8 space-y-4 transition-all duration-300 hover:shadow-xl">
        <div class="flex items-start gap-4">
          <span class="text-3xl">©️</span>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">
              Copyright Notice
            </h2>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Semua konten donghua dan anime yang tersedia di website ini adalah hak cipta dari pemilik aslinya. 
              Kami tidak mengklaim kepemilikan atas konten apapun yang ditampilkan. 
              Jika Anda adalah pemilik konten dan ingin konten Anda dihapus, silakan hubungi kami melalui kontak yang tersedia.
            </p>
          </div>
        </div>
      </section>

      <!-- Third Party Content -->
      <section class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-8 space-y-4 transition-all duration-300 hover:shadow-xl">
        <div class="flex items-start gap-4">
          <span class="text-3xl">🔗</span>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">
              Third Party Content
            </h2>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
              Website ini menggunakan layanan dari pihak ketiga untuk streaming dan download konten:
            </p>
            <ul class="space-y-2 text-zinc-600 dark:text-zinc-400">
              <li class="flex items-start gap-2">
                <span class="text-black dark:text-white mt-1">•</span>
                <span>Server streaming dari berbagai penyedia layanan video hosting</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-black dark:text-white mt-1">•</span>
                <span>Link download dari Google Drive, MEGA, MediaFire, dan platform file sharing lainnya</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-black dark:text-white mt-1">•</span>
                <span>Poster dan gambar dari sumber pihak ketiga</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- User Responsibility -->
      <section class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-8 space-y-4 transition-all duration-300 hover:shadow-xl">
        <div class="flex items-start gap-4">
          <span class="text-3xl">⚠️</span>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">
              User Responsibility
            </h2>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
              Dengan menggunakan website ini, pengguna setuju untuk:
            </p>
            <ul class="space-y-2 text-zinc-600 dark:text-zinc-400">
              <li class="flex items-start gap-2">
                <span class="text-black dark:text-white mt-1">✓</span>
                <span>Menggunakan konten untuk keperluan pribadi dan hiburan saja</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-black dark:text-white mt-1">✓</span>
                <span>Tidak mendistribusikan ulang konten untuk kepentingan komersial</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-black dark:text-white mt-1">✓</span>
                <span>Memahami risiko menggunakan layanan pihak ketiga</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-black dark:text-white mt-1">✓</span>
                <span>Mendukung karya original dengan membeli lisensi resmi jika tersedia</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- DMCA Takedown -->
      <section class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-8 space-y-4 transition-all duration-300 hover:shadow-xl">
        <div class="flex items-start gap-4">
          <span class="text-3xl">🛡️</span>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">
              DMCA Takedown Request
            </h2>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Jika Anda adalah pemilik hak cipta dan menemukan konten Anda di website ini tanpa izin, 
              kami akan segera menghapus link yang mengarah ke konten tersebut. 
              Silakan hubungi kami dengan informasi lengkap mengenai konten yang dimaksud.
            </p>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="bg-gradient-to-br from-zinc-50 to-zinc-100 dark:from-zinc-900 dark:to-zinc-800 rounded-2xl border border-zinc-200 dark:border-zinc-700 p-8 text-center">
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">
          Butuh Bantuan?
        </h3>
        <p class="text-zinc-600 dark:text-zinc-400 mb-4">
          Jika ada pertanyaan atau keluhan, silakan hubungi kami melalui channel WhatsApp
        </p>
        <a 
          href="https://whatsapp.com/channel/0029Vb7PIC9KQuJRWvETIR2y"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-black dark:bg-white text-white dark:text-black font-medium rounded-xl hover:scale-105 transition-transform duration-200"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Hubungi Kami
        </a>
      </section>
    </div>
  </div>
</Layout>
