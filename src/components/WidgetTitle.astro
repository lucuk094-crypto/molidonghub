---
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;
---

<div class="flex justify-between items-center gap-4 flex-wrap mb-6">
  <h2 class="text-2xl md:text-3xl font-bold text-gradient line-clamp-2">{title}</h2>
  {
    href && (
      <a
        href={href}
        type="button"
        class="text-white dark:text-black bg-black dark:bg-white 
        hover:bg-zinc-800 dark:hover:bg-zinc-200 
        focus:ring-2 focus:outline-none focus:ring-zinc-500 
        font-medium rounded-lg text-sm px-5 py-2.5 
        inline-flex items-center gap-2
        transition-all duration-200 hover:scale-105"
      >
        <span>More</span>
        <svg
          class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"
          />
        </svg>
      </a>
    )
  }
</div>
