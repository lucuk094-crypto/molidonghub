---
import Layout from "@layouts/Layout.astro";
import animeConfig from "@configs/animeConfig";

interface Props {
  statusCode: number;
  message: string;
}

const { statusCode, message } = Astro.props;
const {
  molidonghub: { siteName },
} = animeConfig;
const title = `${statusCode} ${message} - ${siteName}`;
---

<Layout
  seo={{
    title,
    noindex: true,
    nofollow: true,
  }}
>
  <div class="flex flex-col items-center justify-center min-h-[60vh] py-12 px-4">
    <div class="text-center space-y-6 max-w-2xl">
      <!-- Error Code -->
      <div class="text-9xl font-bold text-zinc-200 dark:text-zinc-800">
        {statusCode}
      </div>
      
      <!-- Error Message -->
      <h1 class="text-3xl md:text-4xl font-bold text-zinc-900 dark:text-white">
        {message || "Terjadi Kesalahan"}
      </h1>
      
      <!-- Description -->
      <p class="text-zinc-600 dark:text-zinc-400 text-lg">
        {statusCode === 404 
          ? "Anime atau episode yang kamu cari tidak ditemukan. Mungkin sudah dihapus atau URL-nya salah."
          : statusCode === 500
          ? "Terjadi kesalahan server. Silakan coba lagi nanti atau hubungi admin."
          : "Halaman yang kamu cari tidak dapat diakses saat ini."
        }
      </p>
      
      <!-- Actions -->
      <div class="flex flex-wrap gap-4 justify-center pt-4">
        <a 
          href={Astro.url.origin}
          class="px-6 py-3 bg-black dark:bg-white text-white dark:text-black font-medium rounded-xl hover:scale-105 transition-transform duration-200"
        >
          🏠 Kembali ke Home
        </a>
        
        <a 
          href="/ongoing"
          class="px-6 py-3 bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-white font-medium rounded-xl hover:scale-105 transition-transform duration-200"
        >
          📺 Lihat Ongoing
        </a>
        
        <a 
          href="/genres"
          class="px-6 py-3 bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-white font-medium rounded-xl hover:scale-105 transition-transform duration-200"
        >
          🎭 Browse Genre
        </a>
      </div>
      
      <!-- Suggestions -->
      {statusCode === 404 && (
        <div class="mt-12 pt-8 border-t border-zinc-200 dark:border-zinc-800">
          <h2 class="text-xl font-bold text-zinc-900 dark:text-white mb-4">
            Saran untuk kamu:
          </h2>
          <ul class="text-left space-y-2 text-zinc-600 dark:text-zinc-400 inline-block">
            <li>✓ Cek kembali ejaan URL</li>
            <li>✓ Gunakan fitur Search untuk cari anime</li>
            <li>✓ Browse dari halaman Ongoing atau Completed</li>
            <li>✓ Lihat daftar A-Z untuk cari berdasarkan huruf</li>
          </ul>
        </div>
      )}
    </div>
  </div>
</Layout>
