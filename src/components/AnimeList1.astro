---
import generateUrlPath from "@utils/generateUrlPath";

interface Props {
  anime: {
    list: AnimeCard1[];
    baseUrlPath: string;
  };
}

const {
  anime: { list, baseUrlPath },
} = Astro.props;

const FALLBACK_IMAGE = "/images/logo.png";
---

<div class={`py-6 gap-4 grid xs:grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5`}>
  {
    list.map((anime) => (
      <a
        href={generateUrlPath(
          baseUrlPath,
          anime.animeId || anime.batchId || ""
        )}
        class="anime-card"
      >
        <div class="relative overflow-hidden rounded-xl">
          <img
            loading="lazy"
            class="anime1-item-img"
            src={anime.poster || FALLBACK_IMAGE}
            alt={anime.title}
            onerror={`this.src='${FALLBACK_IMAGE}';this.onerror=null;`}
          />
          <span class="anime1-item-eps">Ep {anime.episodes}</span>
        </div>
        <div class="p-3">
          <h3 class="anime1-item-title">{anime.title}</h3>
        </div>
      </a>
    ))
  }
</div>
