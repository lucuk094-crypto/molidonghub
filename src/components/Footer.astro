---
import animeConfig from "@configs/animeConfig";
import CoffeIcon from "./icons/CoffeIcon.astro";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

interface Props {
  navLinks: {
    _1: {
      title: string;
      href: string;
    }[];
    _2: {
      title: string;
      href: string;
      targetBlank?: boolean;
    }[];
  };
}

const {
  molidonghub: { siteName, logo },
} = animeConfig;
const { navLinks } = Astro.props;
---

<footer class="bg-zinc-50 dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800">
  <div class="container w-full py-12 lg:py-16">
    <div class="lg:flex lg:justify-between gap-12">
      <div class="mb-8 lg:mb-0 max-w-[500px]">
        <a href={Astro.url.origin} class="flex items-center max-w-min group">
          <img src={logo} class="w-10 h-10 me-3 transition-transform duration-300 group-hover:scale-110" alt=`${siteName} Logo` />
          <span
            class="self-center text-2xl font-bold whitespace-nowrap text-black dark:text-white"
            >{siteName}</span
          >
        </a>
        <p class="py-4 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
          This site does not store any files on our server, we are linked to the
          media which is hosted on 3rd party services.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-12 md:gap-16">
        <ul
          class="flex flex-col gap-4 text-zinc-600 dark:text-zinc-400 font-medium text-sm"
        >
          {
            navLinks._1.map((link) => (
              <li>
                <a href={link.href} class="hover:text-black dark:hover:text-white transition-colors duration-200 max-w-min">
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
        <ul
          class="flex flex-col gap-4 text-zinc-600 dark:text-zinc-400 font-medium text-sm"
        >
          {
            navLinks._2.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.targetBlank ? "_blank" : ""}
                  class="hover:text-black dark:hover:text-white transition-colors duration-200 max-w-min"
                >
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <hr class="my-8 border-zinc-200 dark:border-zinc-800 lg:my-10" />
    <div class="sm:flex sm:items-center sm:justify-between">
      <span class="text-sm text-zinc-600 dark:text-zinc-400"
        >© {new Date().getFullYear()}
        <a href={Astro.url.origin} class="hover:text-black dark:hover:text-white transition-colors duration-200 font-medium">{siteName} | Van-XOffice</a>. All
        Rights Reserved.
      </span>
      <div class="flex mt-4 sm:justify-center sm:mt-0 gap-4">
        <a
          href="https://whatsapp.com/channel/0029Vb7PIC9KQuJRWvETIR2y"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-600 dark:text-zinc-400 hover:text-black dark:hover:text-white transition-all duration-200 hover:scale-110"
          title="WhatsApp Channel"
        >
          <WhatsAppIcon />
        </a>
        <a
          href="https://saweria.co/vanxstore"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-600 dark:text-zinc-400 hover:text-black dark:hover:text-white transition-all duration-200 hover:scale-110"
          title="Donasi via Saweria"
        >
          <CoffeIcon />
        </a>
      </div>
    </div>
  </div>
</footer>
